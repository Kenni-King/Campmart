AI_ENABLED=true
AI_PROVIDER=mistral
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.mistral.ai/v1
AI_LLM_MODEL=mistral-small-latest
AI_EMBEDDING_MODEL=mistral-embed
AI_EMBEDDING_DIMENSIONS=1024
AI_REQUEST_TIMEOUT=120
AI_LOG_REQUESTS=true
