# =====================================================
# CampMart AI configuration
# Copy to .env and fill in your keys. Do NOT commit .env.
#
# Any OpenAI-compatible provider works (base URL + key +
# model names). Pick ONE set of values below.
# =====================================================

# ---- Option A: Ollama (FREE, local, offline, no key) ----
# Install: https://ollama.com  then run:
#   ollama pull nomic-embed-text
#   ollama pull llama3.2
# AI_ENABLED=true
# AI_PROVIDER=ollama
# AI_API_KEY=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_LLM_MODEL=llama3.2
# AI_EMBEDDING_MODEL=nomic-embed-text
# AI_EMBEDDING_DIMENSIONS=768

# ---- Option B: OpenAI (paid, default) ----
# Key: https://platform.openai.com/api-keys  (needs billing credit)
# AI_ENABLED=true
# AI_PROVIDER=openai
# AI_API_KEY=sk-YOUR-KEY-HERE
# AI_BASE_URL=https://api.openai.com/v1
# AI_LLM_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIMENSIONS=1536

# ---- Option C: Mistral (free tier, OpenAI-compatible) ----
# Key: https://console.mistral.ai  (free "Experiment" plan)
# AI_ENABLED=true
# AI_PROVIDER=mistral
# AI_API_KEY=YOUR-MISTRAL-KEY
# AI_BASE_URL=https://api.mistral.ai/v1
# AI_LLM_MODEL=mistral-small-latest
# AI_EMBEDDING_MODEL=mistral-embed
# AI_EMBEDDING_DIMENSIONS=1024

# ---- Option D: Google Gemini (free tier via OpenAI-compat) ----
# Key: https://aistudio.google.com/apikey
# AI_ENABLED=true
# AI_PROVIDER=gemini
# AI_API_KEY=YOUR-GEMINI-KEY
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_LLM_MODEL=gemini-2.0-flash
# AI_EMBEDDING_MODEL=text-embedding-004
# AI_EMBEDDING_DIMENSIONS=768

# ---- Shared settings ----
AI_REQUEST_TIMEOUT=120
AI_LOG_REQUESTS=true
