{
  "openapi": "3.0.3",
  "info": {
    "title": "CampMart API v1",
    "description": "REST API for the CampMart mobile application. Campus marketplace for buying, selling, and trading.",
    "version": "1.0.0",
    "contact": {
      "name": "CampMart Support",
      "email": "support@campmart.ng"
    }
  },
  "servers": [
    {
      "url": "/campmartv2/api/v1",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" },
          "data": { "type": "object" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": { "type": "object", "nullable": true }
        }
      },
      "PaginatedResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "array", "items": {} },
          "pagination": {
            "type": "object",
            "properties": {
              "current_page": { "type": "integer" },
              "per_page": { "type": "integer" },
              "total_items": { "type": "integer" },
              "total_pages": { "type": "integer" },
              "has_next": { "type": "boolean" },
              "has_prev": { "type": "boolean" }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "full_name": { "type": "string" },
          "firstname": { "type": "string" },
          "lastname": { "type": "string" },
          "phone": { "type": "string" },
          "role": { "type": "string", "enum": ["user", "seller", "admin"] },
          "status": { "type": "string" },
          "profile_image": { "type": "string", "nullable": true },
          "university": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "slug": { "type": "string" }
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "number", "format": "float" },
          "original_price": { "type": "number", "nullable": true },
          "condition_type": { "type": "string" },
          "negotiable": { "type": "boolean" },
          "availability": { "type": "string" },
          "stock_quantity": { "type": "integer" },
          "delivery_fee": { "type": "number" },
          "category": { "$ref": "#/components/schemas/Category" },
          "seller": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "full_name": { "type": "string" },
              "username": { "type": "string" },
              "rating": { "type": "number" }
            }
          },
          "primary_image": { "type": "string", "nullable": true },
          "views_count": { "type": "integer" },
          "bookmarks_count": { "type": "integer" },
          "is_bookmarked": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "product_count": { "type": "integer" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "order_number": { "type": "string" },
          "status": { "type": "string" },
          "payment_status": { "type": "string" },
          "delivery_status": { "type": "string" },
          "item_price": { "type": "number" },
          "service_fee": { "type": "number" },
          "total_amount": { "type": "number" },
          "payment_method": { "type": "string" },
          "delivery_location": { "type": "string" },
          "product": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "image": { "type": "string", "nullable": true }
            }
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "product_id": { "type": "integer" },
          "quantity": { "type": "integer" },
          "delivery_option": { "type": "string" },
          "title": { "type": "string" },
          "price": { "type": "number" },
          "item_total": { "type": "number" },
          "delivery_fee": { "type": "number" },
          "product_image": { "type": "string", "nullable": true }
        }
      },
      "Bookmark": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "type": { "type": "string" },
          "product": { "type": "object", "nullable": true },
          "service": { "type": "object", "nullable": true },
          "created_at": { "type": "string" }
        }
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "description": { "type": "string" },
          "short_description": { "type": "string", "nullable": true },
          "pricing_type": { "type": "string", "enum": ["fixed", "hourly", "daily", "project"] },
          "price": { "type": "number" },
          "delivery_time": { "type": "string", "nullable": true },
          "availability": { "type": "string", "enum": ["available", "busy", "unavailable"] },
          "rating": { "type": "number" },
          "total_ratings": { "type": "integer" },
          "total_orders": { "type": "integer" },
          "views_count": { "type": "integer" },
          "bookmarks_count": { "type": "integer" },
          "portfolio_images": { "type": "array", "items": { "type": "string" } },
          "skills": { "type": "array", "items": { "type": "string" } },
          "is_featured": { "type": "boolean" },
          "is_bookmarked": { "type": "boolean" },
          "category": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "slug": { "type": "string" },
              "icon": { "type": "string" },
              "color_code": { "type": "string" }
            }
          },
          "provider": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "full_name": { "type": "string" },
              "username": { "type": "string" },
              "rating": { "type": "number" },
              "profile_image": { "type": "string", "nullable": true }
            }
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "review_text": { "type": "string", "nullable": true },
          "images": { "type": "array", "items": { "type": "string" } },
          "is_verified_purchase": { "type": "boolean" },
          "helpful_count": { "type": "integer" },
          "review_type": { "type": "string", "enum": ["product", "service", "seller", "buyer"] },
          "reviewer": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "full_name": { "type": "string" },
              "username": { "type": "string" },
              "profile_image": { "type": "string", "nullable": true }
            }
          },
          "product": {
            "type": "object",
            "properties": { "id": { "type": "integer" }, "title": { "type": "string" } }
          },
          "service": {
            "type": "object",
            "properties": { "id": { "type": "integer" }, "title": { "type": "string" } }
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "type": { "type": "string", "enum": ["message", "transaction", "product", "service", "system", "promotion"] },
          "related_id": { "type": "integer", "nullable": true },
          "related_type": { "type": "string", "nullable": true },
          "action_url": { "type": "string", "nullable": true },
          "is_read": { "type": "boolean" },
          "read_at": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "other_user": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "full_name": { "type": "string" },
              "username": { "type": "string" },
              "profile_image": { "type": "string", "nullable": true }
            }
          },
          "last_message": {
            "type": "object",
            "nullable": true,
            "properties": {
              "message": { "type": "string" },
              "sender_id": { "type": "integer" },
              "created_at": { "type": "string" }
            }
          },
          "unread_count": { "type": "integer" },
          "product": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": { "type": "integer" },
              "title": { "type": "string" },
              "image": { "type": "string", "nullable": true }
            }
          },
          "service": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": { "type": "integer" },
              "title": { "type": "string" }
            }
          },
          "last_message_at": { "type": "string" },
          "created_at": { "type": "string" }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "message": { "type": "string" },
          "attachment_url": { "type": "string", "nullable": true },
          "sender_id": { "type": "integer" },
          "is_read": { "type": "boolean" },
          "read_at": { "type": "string", "nullable": true },
          "created_at": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["firstname", "lastname", "email", "phone", "password"],
                "properties": {
                  "firstname": { "type": "string" },
                  "lastname": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "phone": { "type": "string" },
                  "password": { "type": "string", "minLength": 8 },
                  "university_id": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "user": { "$ref": "#/components/schemas/User" },
                            "access_token": { "type": "string" },
                            "refresh_token": { "type": "string" },
                            "token_type": { "type": "string", "example": "Bearer" },
                            "expires_in": { "type": "integer", "example": 86400 }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": { "description": "Email or phone already registered" },
          "422": { "description": "Validation failed" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login with email/phone and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["emailOrPhone", "password"],
                "properties": {
                  "emailOrPhone": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "user": { "$ref": "#/components/schemas/User" },
                            "access_token": { "type": "string" },
                            "refresh_token": { "type": "string" },
                            "token_type": { "type": "string" },
                            "expires_in": { "type": "integer" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Logout (invalidate session)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh_token"],
                "properties": {
                  "refresh_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token refreshed" },
          "401": { "description": "Invalid refresh token" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get current authenticated user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/User" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List products (paginated, searchable)",
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "integer" }, "description": "Filter by category ID" },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search in title/description" },
          { "name": "condition", "in": "query", "schema": { "type": "string", "enum": ["new", "like_new", "good", "fair"] } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["newest", "price_low", "price_high", "popular", "oldest"] } },
          { "name": "min_price", "in": "query", "schema": { "type": "number" } },
          { "name": "max_price", "in": "query", "schema": { "type": "number" } },
          { "name": "seller_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated product list",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/PaginatedResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Product" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Create a new product listing",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["title", "category_id", "price", "description"],
                "properties": {
                  "title": { "type": "string" },
                  "category_id": { "type": "integer" },
                  "price": { "type": "number" },
                  "original_price": { "type": "number" },
                  "description": { "type": "string" },
                  "condition_type": { "type": "string", "default": "good" },
                  "negotiable": { "type": "integer", "enum": [0, 1] },
                  "available_quantity": { "type": "integer", "default": 1 },
                  "delivery_fee": { "type": "number", "default": 1500 },
                  "images": { "type": "array", "items": { "type": "string", "format": "binary" }, "maxItems": 5 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Product created" },
          "422": { "description": "Validation failed" }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get product details",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Product detail with images",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/Product" }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": { "description": "Product not found" }
        }
      },
      "put": {
        "tags": ["Products"],
        "summary": "Update own product",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "price": { "type": "number" },
                  "category_id": { "type": "integer" },
                  "condition_type": { "type": "string" },
                  "negotiable": { "type": "integer" },
                  "available_quantity": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Product updated" },
          "404": { "description": "Not found or unauthorized" }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Delete own product",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Product deleted" },
          "404": { "description": "Not found or unauthorized" }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "List all categories with product counts",
        "responses": {
          "200": {
            "description": "Category list",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Category" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/categories/{id}": {
      "get": {
        "tags": ["Categories"],
        "summary": "Get category with subcategories",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Category detail" },
          "404": { "description": "Category not found" }
        }
      }
    },
    "/user/profile": {
      "get": {
        "tags": ["User"],
        "summary": "Get own profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/User" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["User"],
        "summary": "Update profile",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstname": { "type": "string" },
                  "lastname": { "type": "string" },
                  "phone": { "type": "string" },
                  "bio": { "type": "string" },
                  "location": { "type": "string" },
                  "username": { "type": "string" },
                  "department": { "type": "string" },
                  "level": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated" },
          "409": { "description": "Username taken" }
        }
      }
    },
    "/user/password": {
      "put": {
        "tags": ["User"],
        "summary": "Change password",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["current_password", "new_password", "confirm_password"],
                "properties": {
                  "current_password": { "type": "string" },
                  "new_password": { "type": "string", "minLength": 8 },
                  "confirm_password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password changed" },
          "401": { "description": "Current password incorrect" }
        }
      }
    },
    "/user/avatar": {
      "post": {
        "tags": ["User"],
        "summary": "Upload profile avatar",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["avatar"],
                "properties": {
                  "avatar": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Avatar uploaded" },
